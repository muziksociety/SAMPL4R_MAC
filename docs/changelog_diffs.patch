+    float wW = waveformArea.getWidth();
+    float mx = (float)e.getPosition().x;
+    float my = (float)e.getPosition().y;
+
+    // Only handle trim if within waveform vertical area
+    if (my >= waveformArea.getY() && my <= waveformArea.getBottom())
+    {
+        float startX = wX + wW * trimStart_;
+        float endX = wX + wW * trimEnd_;
+        const float hitZone = 8.0f;  // pixels of grab zone
+
+        if (std::abs(mx - startX) < hitZone)
+        {
+            trimDragging_ = true;
+            activeTrimHandle_ = TrimHandle::Start;
+            return;
+        }
+        else if (std::abs(mx - endX) < hitZone)
+        {
+            trimDragging_ = true;
+            activeTrimHandle_ = TrimHandle::End;
+            return;
+        }
+    }
+
+    // Not a trim drag - let normal click handling proceed
+    // (Shift+click selection is handled via onTileClicked_ in mouseUp)
 }
 
