+// ============ TRIM: Apply / Undo / Cleanup ============
+
+void SampleBrowserPage::applyTrim(int tileIndex)
+{
+    auto* tile = findTileForIndex(tileIndex);
+    if (!tile) return;
+
+    const auto& srcFile = tile->file();
+    float trimStart = tile->getTrimStart();
+    float trimEnd = tile->getTrimEnd();
+
+    if (trimStart < 0.001f && trimEnd > 0.999f)
+    {
+        juce::Logger::writeToLog("[Trim] No trim to apply for " + srcFile.getFileName());
+        return;
+    }
+
+    juce::Logger::writeToLog("[Trim] === APPLYING TRIM === " + srcFile.getFileName()
+                             + " start=" + juce::String(trimStart, 3)
+                             + " end=" + juce::String(trimEnd, 3));
+
+    // Read the original audio
+    std::unique_ptr<juce::AudioFormatReader> reader(formatManager_.createReaderFor(srcFile));
+    if (!reader)
+    {
+        juce::Logger::writeToLog("[Trim] ERROR: Could not read file: " + srcFile.getFullPathName());
+        return;
+    }
+
+    juce::int64 totalSamples = reader->lengthInSamples;
+    double sampleRate = reader->sampleRate;
+    int numChannels = (int)reader->numChannels;
+    int bitsPerSample = (int)reader->bitsPerSample;
+
+    juce::int64 startSample = (juce::int64)(trimStart * totalSamples);
+    juce::int64 endSample = (juce::int64)(trimEnd * totalSamples);
+    juce::int64 trimmedLength = endSample - startSample;
+
+    if (trimmedLength <= 0)
+    {
+        juce::Logger::writeToLog("[Trim] ERROR: Trimmed length is zero");
+        return;
+    }
+
+    // Read the trimmed portion
+    juce::AudioBuffer<float> trimmedBuffer(numChannels, (int)trimmedLength);
+    reader->read(&trimmedBuffer, 0, (int)trimmedLength, startSample, true, true);
+    reader.reset();  // Release file handle
+
+    // Save backup of original (if not already backed up)
+    juce::String filePath = srcFile.getFullPathName();
+    if (trimBackups_.find(filePath) == trimBackups_.end())
+    {
+        juce::File tempDir = juce::File::getSpecialLocation(juce::File::tempDirectory);
+        juce::File backupFile = tempDir.getChildFile("sm5_trim_backup_" + juce::String(juce::Random::getSystemRandom().nextInt64()) + ".wav");
+        if (srcFile.copyFileTo(backupFile))
+        {
+            trimBackups_[filePath] = backupFile;
+            juce::Logger::writeToLog("[Trim] Backup saved: " + backupFile.getFullPathName());
+        }
+        else
+        {
+            juce::Logger::writeToLog("[Trim] WARNING: Could not create backup!");
+        }
+    }
+
+    // Write trimmed audio back to the original file
+    juce::File tempOutput = srcFile.getSiblingFile(srcFile.getFileNameWithoutExtension() + "_trimmed_tmp.wav");
+    {
+        std::unique_ptr<juce::AudioFormatWriter> writer(
+            juce::WavAudioFormat().createWriterFor(
+                new juce::FileOutputStream(tempOutput),
+                sampleRate, numChannels, bitsPerSample, {}, 0));
+
+        if (writer)
+        {
+            writer->writeFromAudioSampleBuffer(trimmedBuffer, 0, (int)trimmedLength);
+            writer.reset();  // Flush and close
+
+            // Replace original with trimmed version
+            if (tempOutput.moveFileTo(srcFile))
+            {
+                juce::Logger::writeToLog("[Trim] ✅ File trimmed successfully: " + srcFile.getFileName()
+                                         + " (" + juce::String(totalSamples) + " -> " + juce::String(trimmedLength) + " samples)");
+            }
+            else
+            {
+                // moveFileTo can fail on Windows - try copy + delete
+                if (tempOutput.copyFileTo(srcFile))
+                {
+                    tempOutput.deleteFile();
+                    juce::Logger::writeToLog("[Trim] ✅ File trimmed (copy fallback): " + srcFile.getFileName());
+                }
+                else
+                {
+                    juce::Logger::writeToLog("[Trim] ❌ ERROR: Could not replace original file");
+                    tempOutput.deleteFile();
+                    return;
+                }
+            }
+        }
+        else
+        {
+            juce::Logger::writeToLog("[Trim] ❌ ERROR: Could not create writer for trimmed file");
+            tempOutput.deleteFile();
+            return;
+        }
+    }
+
+    // Reset tile trim points and refresh waveform
+    tile->setTrimPoints(0.0f, 1.0f);
+    tile->setFile(srcFile);
+
+    // Invalidate and re-preload into cache for instant playback
+    if (sampleCache_)
+    {
+        sampleCache_->invalidateFile(srcFile);
+        juce::Array<juce::File> filesToPreload;
+        filesToPreload.add(srcFile);
+        sampleCache_->requestPreload(filesToPreload, true);
+    }
+
+    juce::Logger::writeToLog("[Trim] === TRIM COMPLETE ===");
+}
+
+void SampleBrowserPage::undoTrim(int tileIndex)
+{
+    auto* tile = findTileForIndex(tileIndex);
+    if (!tile) return;
+
+    juce::String filePath = tile->file().getFullPathName();
+    auto it = trimBackups_.find(filePath);
+    if (it == trimBackups_.end())
+    {
+        juce::Logger::writeToLog("[Trim] No backup found for: " + filePath);
+        return;
+    }
+
+    juce::File backupFile = it->second;
+    juce::File targetFile(filePath);
+
+    juce::Logger::writeToLog("[Trim] === UNDO TRIM === " + targetFile.getFileName());
+
+    if (backupFile.copyFileTo(targetFile))
+    {
+        // Remove backup entry
+        backupFile.deleteFile();
+        trimBackups_.erase(it);
+
+        // Reset tile and refresh
+        tile->setTrimPoints(0.0f, 1.0f);
+        tile->setFile(targetFile);
+
+        // Invalidate and re-preload into cache
+        if (sampleCache_)
+        {
+            sampleCache_->invalidateFile(targetFile);
+            juce::Array<juce::File> filesToPreload;
+            filesToPreload.add(targetFile);
+            sampleCache_->requestPreload(filesToPreload, true);
+        }
+
+        juce::Logger::writeToLog("[Trim] ✅ Undo trim successful");
+    }
+    else
+    {
+        juce::Logger::writeToLog("[Trim] ❌ ERROR: Could not restore backup");
+    }
+}
+
+bool SampleBrowserPage::hasTrimBackup(int tileIndex) const
+{
+    // Find the tile to get its file path
+    for (auto* tile : tiles_)
+    {
+        if (tile->sampleIndex() == tileIndex)
+            return trimBackups_.find(tile->file().getFullPathName()) != trimBackups_.end();
+    }
+    return false;
+}
+
+void SampleBrowserPage::cleanupTrimBackups()
+{
+    juce::Logger::writeToLog("[Trim] Cleaning up " + juce::String((int)trimBackups_.size()) + " trim backups");
+    for (auto& [path, backupFile] : trimBackups_)
+    {
+        if (backupFile.existsAsFile())
+            backupFile.deleteFile();
+    }
+    trimBackups_.clear();
+}
+
