            "compressor": { "enabled": true, "threshold": -12, "ratio": 6, "attack": 5, "release": 80, "makeupGain": 6, "dryWet": 100 },
            "limiter": { "enabled": true, "ceiling": -0.1, "release": 5 },
            "eq": { "enabled": true, "lowGain": 3, "midGain": -2, "highGain": 1 }
          }
        },
        {
