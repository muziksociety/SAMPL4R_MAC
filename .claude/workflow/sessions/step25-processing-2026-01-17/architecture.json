  "workflow_step_integration": {
    "enum_change": {
      "before": "enum class WorkflowStep { Step1_SelectLength, Step2_DownbeatLoops, Step3_SampleSlice }",
      "after": "enum class WorkflowStep { Step1_SelectLength, Step2_DownbeatLoops, Step25_Processing, Step3_SampleSlice }"
    },
    "transitions": {
      "Step1_to_Step2": "Unchanged - transitionToStep2()",
      "Step2_to_Step25": "NEW - transitionToStep25(): validates tempo detection complete, transitions to Step25_Processing",
      "Step25_to_Step3": "NEW - transitionToStep3FromStep25(): finalizes processed buffer, transitions to Step3_SampleSlice",
      "Step3_from_Step25": "Modified - transitionToStep3() REMOVED direct call, must go through Step25"
    },
    "processed_buffer_flow": {
      "step1": "Original file loaded into thumbnail_",
      "step2": "Selection locked, original buffer analyzed for tempo",
      "step25": "Original buffer -> PreSliceProcessingService -> processedBuffer_",
      "step3": "processedBuffer_ used for slice generation (NOT original)"
    }
  },

  "waveform_update_design": {
    "approach": "Maintain separate processedThumbnail_ for displaying processed audio",
    "implementation": [
      "1. Keep original thumbnail_ for reference",
      "2. Create processedThumbnail_ when entering Step 2.5",
      "3. On parameter change:",
      "   a. Copy original buffer to processingBuffer",
      "   b. Apply effects chain",
      "   c. Update processedThumbnail_ from processed buffer",
      "   d. Trigger repaint()"
    ],
    "optimization": "Debounce parameter changes - only process after 50ms of no changes",
    "threading": {
      "parameter_update": "UI thread - store pending values",
      "processing": "Background thread via ThreadPool",
      "thumbnail_update": "Message thread via AsyncUpdater"
    }
  },

