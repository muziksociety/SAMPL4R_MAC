  "architecture_overview": {
    "summary": "Step 2.5 PROCESSING adds a pre-slice audio effects chain with 5 processors (Gate, Expander, Compressor, Limiter, EQ). Processing happens on a background thread with live waveform updates via AsyncUpdater.",
    "key_components": [
      "PreSliceProcessingService - Coordinates effect chain and background processing",
      "ExpanderProcessor - NEW DSP processor class",
      "Enhanced CompressorProcessor - Added dry/wet blend",
      "Enhanced NoiseGateProcessor - Added attack/release/hold",
      "ThresholdLineOverlay - Draggable threshold UI component",
      "ProcessingPresetManager - Preset save/load with factory presets"
    ]
  },

  "service_design": {
    "PreSliceProcessingService": {
      "purpose": "Coordinates the Gate->Expander->Compressor->Limiter->EQ processing chain",
      "interface": {
        "prepare": "void prepare(double sampleRate, int samplesPerBlock)",
        "processBuffer": "juce::AudioBuffer<float> processBuffer(const juce::AudioBuffer<float>& input)",
        "processBufferAsync": "void processBufferAsync(const juce::AudioBuffer<float>& input, std::function<void(juce::AudioBuffer<float>)> callback)",
        "setGateParameter": "void setGateParameter(const juce::String& param, float value)",
        "setExpanderParameter": "void setExpanderParameter(const juce::String& param, float value)",
        "setCompressorParameter": "void setCompressorParameter(const juce::String& param, float value)",
        "setLimiterParameter": "void setLimiterParameter(const juce::String& param, float value)",
        "setEqParameter": "void setEqParameter(const juce::String& param, float value)",
        "setGateEnabled": "void setGateEnabled(bool enabled)",
        "setExpanderEnabled": "void setExpanderEnabled(bool enabled)",
        "setCompressorEnabled": "void setCompressorEnabled(bool enabled)",
        "setLimiterEnabled": "void setLimiterEnabled(bool enabled)",
        "setEqEnabled": "void setEqEnabled(bool enabled)",
        "applyPreset": "void applyPreset(const ProcessingPreset& preset)",
        "getCurrentSettings": "ProcessingPreset getCurrentSettings() const"
      },
      "members": {
        "gateProcessor_": "std::unique_ptr<EnhancedNoiseGateProcessor>",
        "expanderProcessor_": "std::unique_ptr<ExpanderProcessor>",
        "compressorProcessor_": "std::unique_ptr<EnhancedCompressorProcessor>",
        "limiterProcessor_": "std::unique_ptr<LimiterProcessor>",
        "eqProcessor_": "std::unique_ptr<EQ6Processor>",
        "threadPool_": "juce::ThreadPool (1 thread)",
        "currentSampleRate_": "double",
        "currentBlockSize_": "int"
      },
      "threading": {
        "processBuffer": "Sync - processes on calling thread (for preview during drag)",
        "processBufferAsync": "Async - queues to thread pool, calls callback on message thread"
      }
    }
  },

  "processor_designs": {
    "ExpanderProcessor": {
      "purpose": "Dynamic expander - reduces gain below threshold (opposite of compressor)",
      "base_class": "EffectProcessor (from DynamicEffectsProcessor.h)",
      "parameters": {
        "threshold": { "type": "float", "range": "-60 to 0", "unit": "dB", "default": -36.0 },
        "ratio": { "type": "float", "range": "1.0 to 10.0", "unit": "ratio", "default": 2.0 },
        "attack": { "type": "float", "range": "0.1 to 100", "unit": "ms", "default": 5.0 },
        "release": { "type": "float", "range": "10 to 1000", "unit": "ms", "default": 50.0 }
      },
      "algorithm": [
        "1. Calculate RMS envelope of input signal",
        "2. Convert envelope to dB",
        "3. If envelope < threshold:",
        "   - Calculate gain reduction: (threshold - envelope) * (ratio - 1) / ratio",
        "4. Apply attack/release smoothing to gain",
        "5. Apply gain reduction to signal"
      ],
      "implementation_notes": "Similar to JUCE dsp::Compressor but with inverted ratio behavior"
    },
    "EnhancedCompressorProcessor": {
      "purpose": "Compressor with NY-style parallel compression (dry/wet blend)",
      "base_on": "Existing CompressorProcessor",
      "new_parameters": {
        "dryWet": { "type": "float", "range": "0 to 100", "unit": "%", "default": 100 },
        "makeupGain": { "type": "float", "range": "-12 to 24", "unit": "dB", "default": 0 }
      },
      "modified_process": [
        "1. Copy input to dryBuffer",
        "2. Process wetBuffer through compressor",
        "3. Apply makeup gain to wetBuffer",
        "4. Mix: output = dryBuffer * (1 - dryWet/100) + wetBuffer * (dryWet/100)"
      ]
    },
    "EnhancedNoiseGateProcessor": {
      "purpose": "Noise gate with proper attack/release/hold envelope",
      "base_on": "Existing NoiseGateProcessor",
      "new_parameters": {
        "threshold": { "type": "float", "range": "-60 to 0", "unit": "dB", "default": -24.0 },
        "attack": { "type": "float", "range": "0.1 to 50", "unit": "ms", "default": 1.0 },
        "release": { "type": "float", "range": "10 to 500", "unit": "ms", "default": 50.0 },
        "hold": { "type": "float", "range": "0 to 100", "unit": "ms", "default": 10.0 }
      },
      "modified_process": [
        "1. Calculate peak level of input",
        "2. Convert to dB",
        "3. Gate state machine:",
        "   - CLOSED: If level > threshold, transition to ATTACK",
        "   - ATTACK: Ramp gain from 0 to 1 over attack time",
        "   - OPEN: If level < threshold, start hold timer",
        "   - HOLD: Wait hold time, then transition to RELEASE",
        "   - RELEASE: Ramp gain from 1 to 0 over release time",
        "4. Apply gain to signal"
      ]
    },
    "EQ6Processor_Frequency_Update": {
      "purpose": "Update EQ6 frequencies to match user spec",
      "existing_class": "EQ6Processor",
      "frequency_changes": {
        "band1_low_shelf": "80 Hz (was variable)",
        "band2_low_mid_peak": "250 Hz (keep as is)",
        "band3_mid1_peak": "1000 Hz (was 500 Hz)",
        "band4_mid2_peak": "3000 Hz (was 1000 Hz)",
        "band5_high_mid_peak": "8000 Hz (was 2000 Hz)",
        "band6_high_shelf": "12000 Hz (was variable)"
      }
    }
  },

