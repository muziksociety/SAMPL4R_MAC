  "integration_points_with_backend": [
    {
      "ui_element": "Gate threshold slider",
      "backend_call": "PreSliceProcessingService::setGateParameter('threshold', value)",
      "data_type": "float (dB, range -60 to 0)"
    },
    {
      "ui_element": "ThresholdLineOverlay drag",
      "backend_call": "Same as slider - synced bidirectionally",
      "data_type": "float (dB)"
    },
    {
      "ui_element": "Preset combo selection",
      "backend_call": "ProcessingPresetManager::loadPreset(presetName)",
      "data_type": "ProcessingPreset struct"
    },
    {
      "ui_element": "Waveform display",
      "backend_call": "PreSliceProcessingService::getProcessedBuffer()",
      "data_type": "juce::AudioBuffer<float>"
    }
  ]
