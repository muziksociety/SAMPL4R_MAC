  "component_hierarchy": {
    "WavePreviewPage": {
      "children": [
        "backButton_",
        "stepPill1_ (LENGTH)",
        "stepPill2_ (TEMPO)",
        "stepPill25_ (2.5 PROCESS) <- NEW",
        "stepPill3_ (SLICE)",
        "instructionBoxBounds_ (contains step-specific controls)",
        {
          "Step25Controls": {
            "presetComboBox_",
            "savePresetBtn_",
            "loadPresetBtn_",
            "resetBtn_",
            "ProcessingEffectsPanel_": {
              "GateModule": ["bypassToggle", "thresholdSlider", "attackSlider", "releaseSlider", "holdSlider"],
              "ExpanderModule": ["bypassToggle", "thresholdSlider", "ratioSlider", "attackSlider", "releaseSlider"],
              "CompressorModule": ["bypassToggle", "thresholdSlider", "ratioSlider", "attackSlider", "releaseSlider", "makeupSlider", "dryWetSlider"],
              "LimiterModule": ["bypassToggle", "ceilingSlider", "releaseSlider"],
              "EQModule": ["bypassToggle", "lowSlider", "lowMidSlider", "midSlider", "midHighSlider", "highSlider", "airSlider"]
            }
          }
        },
        "playZoneBox_",
        "waveformBounds_ (displays processed waveform)",
        "ThresholdLineOverlay_ <- NEW (transparent overlay over waveform)",
        "selectionFeedbackLabel_",
        "hintBarLabel_",
        "pitchKnob_",
        "speedKnob_",
        "backStepButton_",
        "continueButton_"
      ]
    }
  },

  "user_interaction_flow": {
    "entering_step25": [
      "1. User clicks Continue button from Step 2 (TEMPO)",
      "2. transitionToStep25() is called",
      "3. currentStep_ changes to Step25_Processing",
      "4. Step 2 controls hidden, Step 2.5 controls shown",
      "5. updateStepPills() colors: LENGTH(done), TEMPO(done), 2.5 PROCESS(active), SLICE(locked)",
      "6. ThresholdLineOverlay becomes visible over waveform",
      "7. Initial preset 'Default' is loaded (all effects bypassed)"
    ],
    "adjusting_effects": [
      "1. User enables Gate by clicking bypass toggle",
      "2. Gate module becomes active (orange highlight)",
      "3. User drags threshold slider to -24dB",
      "4. PreSliceProcessingService.setGateParameter('threshold', -24) called",
      "5. Service triggers background processing",
      "6. Waveform redraws with processed audio (shows gate effect)",
      "7. ThresholdLineOverlay updates gate line position"
    ],
    "dragging_threshold_line": [
      "1. User hovers over red gate threshold line on waveform",
      "2. Cursor changes to ns-resize (vertical resize)",
      "3. User clicks and drags line up/down",
      "4. Line follows mouse, tooltip shows current dB value",
      "5. ThresholdLineOverlay calls onThresholdChanged(GATE, newDbValue)",
      "6. WavePreviewPage updates gate threshold slider to match",
      "7. Processing service receives new threshold, reprocesses",
      "8. Waveform updates in real-time"
    ],
    "saving_preset": [
      "1. User adjusts effects to desired settings",
      "2. User clicks [Save] button",
      "3. Dialog appears prompting for preset name",
      "4. User enters name 'My Clean Drums', clicks Save",
      "5. ProcessingPresetManager.saveUserPreset() called",
      "6. Preset saved to Samplar/processing_presets/my_clean_drums.json",
      "7. Preset combo box updates to include new preset"
    ],
    "loading_preset": [
      "1. User clicks preset dropdown",
      "2. User selects 'Punchy Kicks' factory preset",
      "3. ProcessingPresetManager.loadPreset() called",
      "4. All effect parameters updated from preset",
      "5. All UI sliders sync to loaded values",
      "6. Processing service applies new settings",
      "7. Waveform updates to show preset effect"
    ],
    "continuing_to_step3": [
      "1. User clicks Continue button from Step 2.5",
      "2. transitionToStep3FromStep25() is called",
      "3. Processed buffer is finalized (becomes input for Step 3)",
      "4. currentStep_ changes to Step3_SampleSlice",
      "5. Step 2.5 controls hidden, Step 3 controls shown",
      "6. ThresholdLineOverlay hidden",
      "7. Slice generation uses PROCESSED audio buffer"
    ]
  },

