  "deployment_considerations": {
    "render_com": {
      "websocket_support": "Render supports WebSocket connections",
      "scaling": "Single instance initially, scale to multiple with Redis pubsub if needed",
      "database": "Use existing PostgreSQL instance"
    },
    "environment_variables": [
      "CHAT_MESSAGE_RATE_LIMIT=10",
