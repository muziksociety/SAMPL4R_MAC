  "integration_points_with_backend": [
    {
      "point": "Authentication",
      "frontend": "ChatPage requests token from LicenseSystemService",
      "backend": "WebSocket connection includes Authorization header"
    },
    {
      "point": "Message sending",
      "frontend": "ChatService.sendMessage(text)",
      "backend": "WebSocket receives JSON: {type: 'message', text: '...'}"
    },
    {
      "point": "Message receiving",
      "frontend": "ChatService.onMessageReceived callback",
      "backend": "WebSocket broadcasts: {type: 'message', user: '...', text: '...', timestamp: '...'}"
    },
    {
      "point": "User presence",
      "frontend": "usersCountLabel_ updated on connect/disconnect events",
      "backend": "WebSocket broadcasts: {type: 'presence', users_online: N}"
    },
    {
      "point": "Message history",
      "frontend": "REST GET /api/chat/history on page load",
      "backend": "Returns last 50 messages as JSON array"
    }
  ]
