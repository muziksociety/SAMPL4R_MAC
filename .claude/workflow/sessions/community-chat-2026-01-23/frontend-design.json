  "component_hierarchy": {
    "ChatPage": {
      "parent": "juce::Component",
      "children": [
        {
          "name": "backButton_",
          "type": "juce::TextButton",
          "purpose": "Navigate back to SampleBrowserPage"
        },
        {
          "name": "titleLabel_",
          "type": "juce::Label",
          "purpose": "Display 'Community Chat' title"
        },
        {
          "name": "usersCountLabel_",
          "type": "juce::Label",
          "purpose": "Show online user count"
        },
        {
          "name": "settingsButton_",
          "type": "juce::TextButton",
          "purpose": "Open chat settings dialog"
        },
        {
          "name": "messageListViewport_",
          "type": "juce::Viewport",
          "purpose": "Scrollable container for messages",
          "children": [
            {
              "name": "messageListContent_",
              "type": "MessageListComponent (custom)",
              "purpose": "Renders list of MessageBubble components"
            }
          ]
        },
        {
          "name": "inputField_",
          "type": "juce::TextEditor",
          "purpose": "Text input for composing messages"
        },
        {
          "name": "sendButton_",
          "type": "juce::TextButton",
          "purpose": "Send the composed message"
        },
        {
          "name": "connectionStatusIndicator_",
          "type": "ConnectionStatusComponent (custom)",
          "purpose": "Show connection state (dot + text)"
        }
      ]
    },
    "MessageBubble": {
      "parent": "juce::Component",
      "purpose": "Single message display",
      "data": {
        "username": "string",
        "message": "string",
        "timestamp": "juce::Time",
        "isOwnMessage": "bool",
        "isOnline": "bool"
      }
    },
    "ConnectionStatusComponent": {
      "parent": "juce::Component",
      "purpose": "Connection status indicator",
      "states": ["connecting", "connected", "disconnected", "auth_required"]
    }
  },

  "user_interaction_flow": [
    {
      "step": 1,
      "action": "User clicks CHAT button in SampleBrowserPage header",
      "result": "MainWindow.switchTo(7) - shows ChatPage"
    },
    {
      "step": 2,
      "action": "ChatPage appears, attempts WebSocket connection",
      "result": "Shows 'Connecting...' status, connects to server"
    },
    {
      "step": 3,
      "action": "Connection established",
      "result": "Status changes to 'Connected', loads last 50 messages from history"
    },
    {
      "step": 4,
      "action": "User types message in input field",
      "result": "Text appears in input, Send button enables"
    },
    {
      "step": 5,
      "action": "User presses Enter or clicks Send",
      "result": "Message sent via WebSocket, appears in list immediately (optimistic update)"
    },
    {
      "step": 6,
      "action": "Other user sends message",
      "result": "Message appears in list, auto-scrolls if at bottom"
    },
    {
      "step": 7,
      "action": "User scrolls up in message list",
      "result": "Auto-scroll disabled, 'New messages' indicator shows if new messages arrive"
    },
    {
      "step": 8,
      "action": "User clicks Back button",
      "result": "Returns to SampleBrowserPage, WebSocket stays connected in background"
    }
  ],

