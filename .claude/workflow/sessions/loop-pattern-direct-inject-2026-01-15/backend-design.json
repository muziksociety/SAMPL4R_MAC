        "pseudocode": [
          "PatternSet patternSet;",
          "patternSet.name = result.patternName.toStdString();",
          "patternSet.genre = result.genre.toLowerCase().toStdString();",
          "patternSet.isUserPattern = true;",
          "patternSet.gridSize = 16; // default, update from first pattern",
          "",
          "for (const auto& entry : result.patterns) {",
          "    if (entry.pattern.empty()) continue;",
          "    if (patternSet.gridSize == 16 && entry.pattern.size() > 0) {",
          "        patternSet.gridSize = static_cast<int>(entry.pattern.size());",
          "    }",
          "    ",
          "    if (entry.isSubcategory) {",
          "        SubcategoryPattern subPat;",
          "        subPat.baseCategory = entry.category;",
          "        subPat.displayName = entry.displayName;",
          "        subPat.pattern.steps.assign(entry.pattern.begin(), entry.pattern.end());",
          "        patternSet.subcategoryPatterns[entry.displayName] = subPat;",
          "    } else {",
          "        RhythmicPattern rhyPat;",
          "        rhyPat.steps.assign(entry.pattern.begin(), entry.pattern.end());",
          "        patternSet.patterns[entry.category] = rhyPat;",
          "    }",
          "}",
          "return patternSet;"
        ]
      }
